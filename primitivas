<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Celda de Manufactura - Primitivas A-Frame</title>
    <script src="https://cdn.jsdelivr.net/npm/aframe@1.4.1/dist/aframe-master.min.js"></script>
  </head>
  <body>
    <a-scene>

      <!-- Piso de la planta -->
      <a-plane rotation="-90 0 0" width="20" height="20" color="#8D8D8D"></a-plane>
      <a-sky color="#CFE8FF"></a-sky>

      <!-- ============================ -->
      <!-- ESTACIÓN 1: Banda transportadora -->
      <!-- ============================ -->
      <a-entity id="estacion-banda" position="-3 0 -5">
        <!-- Estructura de la banda -->
        <a-box position="0 0.5 0" width="4" height="0.2" depth="1" color="#3A3A3A"></a-box>
        <!-- Rodillos en los extremos -->
        <a-cylinder position="-2 0.5 0" rotation="0 0 90" radius="0.25" height="1" color="#B0B0B0"></a-cylinder>
        <a-cylinder position="2 0.5 0" rotation="0 0 90" radius="0.25" height="1" color="#B0B0B0"></a-cylinder>
        <!-- Patas de soporte -->
        <a-cylinder position="-1.5 0.15 0" radius="0.08" height="0.3" color="#555555"></a-cylinder>
        <a-cylinder position="1.5 0.15 0" radius="0.08" height="0.3" color="#555555"></a-cylinder>
        <!-- Sensor de presencia -->
        <a-sphere position="0 0.75 0" radius="0.12" color="#EF2D5E"></a-sphere>
      </a-entity>

      <!-- ============================ -->
      <!-- ESTACIÓN 2: Tanque de almacenamiento -->
      <!-- ============================ -->
      <a-entity id="estacion-tanque" position="2 0 -6">
        <a-cylinder position="0 1 0" radius="0.8" height="2" color="#4CC3D9"></a-cylinder>
        <!-- Tapa superior -->
        <a-cylinder position="0 2.05 0" radius="0.85" height="0.1" color="#2E8B99"></a-cylinder>
        <!-- Válvula (indicador) -->
        <a-sphere position="0.85 1.6 0" radius="0.1" color="#FFC65D"></a-sphere>
      </a-entity>

      <!-- ============================ -->
      <!-- ESTACIÓN 3: Brazo robotizado básico -->
      <!-- ============================ -->
      <a-entity id="estacion-robot" position="4 0 -3">
        <!-- Base -->
        <a-cylinder position="0 0.2 0" radius="0.4" height="0.4" color="#444444"></a-cylinder>
        <!-- Brazo 1 (vertical) -->
        <a-box position="0 1 0" width="0.2" height="1.2" depth="0.2" color="#F2A104"></a-box>
        <!-- Brazo 2 (horizontal) -->
        <a-box position="0.6 1.6 0" width="1.2" height="0.2" depth="0.2" color="#F2A104"></a-box>
        <!-- Efector final (sensor/pinza) -->
        <a-sphere position="1.2 1.6 0" radius="0.15" color="#EF2D5E"></a-sphere>
      </a-entity>

      <!-- Luces -->
      <a-entity light="type: ambient; intensity: 0.7"></a-entity>
      <a-entity light="type: directional; intensity: 0.5" position="2 4 2"></a-entity>

      <!-- Cámara con controles -->
      <a-entity camera look-controls wasd-controls position="0 1.6 2"></a-entity>

    </a-scene>
  </body>
</html>
